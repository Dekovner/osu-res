#!/usr/bin/env python3
"""
osu-res: Universal Custom Resolution Manager for osu! (Wine on Linux)
Injects user-specified custom resolutions directly into Wine (win32u) and XRandR / Xwayland,
making them appear natively in the in-game resolution dropdown menu without gamescope or blur.
"""

import os
import sys
import json
import re
import struct
import shutil
import subprocess
import argparse

# Configuration paths
CONFIG_DIR = os.path.expanduser("~/.config/osu-res")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")

# Default modes: Empty by default so users choose only what they need
DEFAULT_MODES = []

# ANSI terminal formatting
GREEN = "\033[1;32m"
BLUE = "\033[1;34m"
YELLOW = "\033[1;33m"
CYAN = "\033[1;36m"
RED = "\033[1;31m"
BOLD = "\033[1m"
RESET = "\033[0m"

def print_banner():
    print(f"{CYAN}{BOLD}===================================================={RESET}")
    print(f"{CYAN}{BOLD}       osu-res: Custom Resolution Tool for Wine     {RESET}")
    print(f"{CYAN}{BOLD}===================================================={RESET}")

def load_config():
    if not os.path.exists(CONFIG_DIR):
        os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_MODES)
        return DEFAULT_MODES
    try:
        with open(CONFIG_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_MODES

def save_config(modes):
    if not os.path.exists(CONFIG_DIR):
        os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(modes, f, indent=2)

def detect_monitor():
    """Detect primary or best connected monitor, its native resolution and refresh rate."""
    try:
        out = subprocess.run(["xrandr"], capture_output=True, text=True, check=True).stdout
    except Exception:
        return {"name": "DP-3", "width": 1920, "height": 1080, "rate": 180}

    outputs = re.findall(
        r"^(\S+) connected (primary )?(\d+)x(\d+)\+(\d+)\+(\d+)[^\n]*\n((?:[ \t]+[^\n]+\n)*)",
        out,
        re.MULTILINE
    )
    monitors = []
    for name, primary, w, h, x, y, modes_block in outputs:
        rate_m = re.search(r"\b([0-9.]+)\*", modes_block)
        active_rate = round(float(rate_m.group(1))) if rate_m else None
        rates = [float(r) for r in re.findall(r"\b([0-9.]+)(?:\*|\+)?\b", modes_block) if float(r) > 20]
        max_rate = round(max(rates)) if rates else (active_rate or 60)
        monitors.append({
            "name": name,
            "primary": bool(primary),
            "width": int(w),
            "height": int(h),
            "rate": active_rate or max_rate
        })

    if not monitors:
        return {"name": "DP-3", "width": 1920, "height": 1080, "rate": 180}

    # Prioritize primary monitor, then highest refresh rate
    best = sorted(monitors, key=lambda m: (m["primary"], m["rate"]), reverse=True)[0]
    return best

def find_win32u():
    """Locate win32u.so across osu-winello, Lutris, Bottles, or system directories."""
    candidates = [
        os.path.expanduser("~/.local/share/osuconfig/wine-osu/lib/wine/x86_64-unix/win32u.so"),
        os.path.expanduser("~/.local/share/osuconfig/wine-osu-cachy/lib/wine/x86_64-unix/win32u.so"),
        os.path.expanduser("~/.local/share/lutris/runners/wine/wine-osu/lib/wine/x86_64-unix/win32u.so"),
        "/usr/lib/wine/x86_64-unix/win32u.so",
        "/usr/lib64/wine/x86_64-unix/win32u.so",
    ]
    # Check WINE_INSTALL_PATH environment variable if defined
    env_path = os.environ.get("WINE_INSTALL_PATH")
    if env_path:
        candidates.insert(0, os.path.join(env_path, "lib/wine/x86_64-unix/win32u.so"))

    for path in candidates:
        if os.path.isfile(path):
            return path
    return None

def find_mode_table_offset(so_path):
    """Dynamically scan binary for Wine's standard default resolution table signature."""
    # Signature: 640x480 (0x280, 0x1e0) followed by 800x600 (0x320, 0x258)
    sig = struct.pack("<IIII", 640, 480, 800, 600)
    with open(so_path, "rb") as f:
        data = f.read()

    pos = data.find(sig)
    return pos

def apply_modes(verbose=True):
    mon = detect_monitor()
    so_path = find_win32u()
    modes = load_config()

    if verbose:
        print(f"{BLUE}[INFO]{RESET} Detected display: {BOLD}{mon['name']}{RESET} ({mon['width']}x{mon['height']} @ {mon['rate']}Hz)")

    # 1. Add custom modes to XRandR / Xwayland
    if modes:
        try:
            xrandr_out = subprocess.run(["xrandr"], capture_output=True, text=True).stdout
            for m in modes:
                w, h = m["width"], m["height"]
                rate = mon["rate"]
                name = f"{w}x{h}_{rate}"
                if f" {w}x{h} " in xrandr_out or name in xrandr_out:
                    continue

                htotal = int(w * 1.15)
                vtotal = int(h * 1.05)
                clock = round((htotal * vtotal * rate) / 1000000.0, 2)
                hsync_start = int(w + (htotal - w) * 0.3)
                hsync_end = int(w + (htotal - w) * 0.6)
                vsync_start = int(h + 3)
                vsync_end = int(h + 7)

                cmd_new = f"xrandr --newmode \"{name}\" {clock} {w} {hsync_start} {hsync_end} {htotal} {h} {vsync_start} {vsync_end} {vtotal} -hsync +vsync"
                cmd_add = f"xrandr --addmode {mon['name']} \"{name}\""
                subprocess.run(cmd_new, shell=True, capture_output=True)
                subprocess.run(cmd_add, shell=True, capture_output=True)
        except Exception:
            pass

    # 2. Patch Wine win32u.so static resolution table
    if so_path:
        bak_path = so_path + ".orig"
        if not os.path.exists(bak_path):
            try:
                shutil.copyfile(so_path, bak_path)
            except Exception as e:
                if verbose:
                    print(f"{YELLOW}[WARN]{RESET} Could not create backup of win32u.so: {e}")

        ref_file = bak_path if os.path.exists(bak_path) else so_path
        offset = find_mode_table_offset(ref_file)
        if offset != -1:
            # Read factory original 24 modes from backup
            stock_modes = []
            with open(ref_file, "rb") as f:
                f.seek(offset)
                for _ in range(24):
                    w, h = struct.unpack("<II", f.read(8))
                    stock_modes.append((w, h))

            if not modes:
                # If no custom modes are configured, restore factory table
                final_modes = list(stock_modes)
            else:
                # Find inactive slots (modes exceeding current monitor resolution, e.g. 2560x1440, 3840x1600 on 1080p)
                inactive_indices = [i for i, (w, h) in enumerate(stock_modes) if w > mon["width"] or h > mon["height"]]
                # Also include ultra-wide bar modes (e.g. 1920x800) if more slots needed
                for i, (w, h) in enumerate(stock_modes):
                    if (w, h) in [(1920, 800), (1440, 960)] and i not in inactive_indices:
                        inactive_indices.append(i)

                final_modes = list(stock_modes)
                user_pairs = [(m["width"], m["height"]) for m in modes]

                # Replace only inactive slots with user custom resolutions
                for idx, user_pair in enumerate(user_pairs):
                    if idx < len(inactive_indices):
                        slot_idx = inactive_indices[idx]
                        final_modes[slot_idx] = user_pair

            try:
                packed = b"".join(struct.pack("<II", w, h) for w, h in final_modes)
                with open(so_path, "r+b") as f:
                    f.seek(offset)
                    current = f.read(len(packed))
                    if current != packed:
                        f.seek(offset)
                        f.write(packed)
                        if verbose:
                            print(f"{GREEN}[OK]{RESET} Wine display table ({os.path.basename(so_path)}) updated successfully!")
            except Exception as e:
                if verbose:
                    print(f"{RED}[ERROR]{RESET} Failed writing to {so_path}: {e}")
        else:
            if verbose:
                print(f"{YELLOW}[WARN]{RESET} Display mode table signature not found in {so_path}.")

    if verbose:
        if modes:
            print(f"{GREEN}[OK]{RESET} All custom resolutions applied! Launch osu! and check Options -> Screen Resolution.")
        else:
            print(f"{GREEN}[OK]{RESET} Stock Wine resolutions active (no custom modes configured).")

def cmd_add(w, h, desc=None):
    modes = load_config()
    for m in modes:
        if m["width"] == w and m["height"] == h:
            print(f"{YELLOW}[WARN]{RESET} Resolution {w}x{h} is already in the list.")
            apply_modes(verbose=False)
            return

    desc = desc or f"{w}x{h} Custom"
    modes.append({"width": w, "height": h, "desc": desc})
    save_config(modes)
    print(f"{GREEN}[OK]{RESET} Added custom resolution: {BOLD}{w}x{h}{RESET} ({desc})")
    apply_modes(verbose=True)

def cmd_remove(w, h):
    modes = load_config()
    initial_len = len(modes)
    modes = [m for m in modes if not (m["width"] == w and m["height"] == h)]
    if len(modes) < initial_len:
        save_config(modes)
        print(f"{GREEN}[OK]{RESET} Resolution {w}x{h} removed.")
        apply_modes(verbose=True)
    else:
        print(f"{YELLOW}[WARN]{RESET} Resolution {w}x{h} not found in the list.")

def cmd_clear():
    save_config([])
    print(f"{GREEN}[OK]{RESET} All custom resolutions cleared.")
    apply_modes(verbose=True)

def cmd_list():
    print_banner()
    mon = detect_monitor()
    so_path = find_win32u()
    print(f"{BLUE}• Display:{RESET} {BOLD}{mon['name']}{RESET} (Native: {mon['width']}x{mon['height']} @ {mon['rate']}Hz)")
    print(f"{BLUE}• Wine Library:{RESET} {so_path or 'Not found'}")
    modes = load_config()
    if not modes:
        print(f"\n{YELLOW}No custom resolutions configured.{RESET}")
        print("Add one using: osu-res add <width> <height> [-d \"description\"]")
        print("Or run 'osu-res' for the interactive menu.\n")
        return

    print(f"\n{BOLD}Configured Custom Resolutions ({len(modes)}):{RESET}")
    for i, m in enumerate(modes, 1):
        ratio = round(m["width"] / m["height"], 2)
        print(f"  [{i:2d}] {BOLD}{m['width']:4d}x{m['height']:<4d}{RESET}  (aspect ratio ~{ratio})  - {m.get('desc', '')}")
    print()

def cmd_restore():
    so_path = find_win32u()
    if not so_path:
        print(f"{RED}[ERROR]{RESET} win32u.so was not found.")
        return
    bak_path = so_path + ".orig"
    if os.path.exists(bak_path):
        shutil.copyfile(bak_path, so_path)
        save_config([])
        print(f"{GREEN}[OK]{RESET} Wine successfully restored from original backup ({bak_path})!")
    else:
        print(f"{YELLOW}[WARN]{RESET} Original backup {bak_path} not found.")

def interactive_menu():
    print_banner()
    while True:
        print(f"\n{BOLD}Select an option:{RESET}")
        print("  1) List custom resolutions")
        print("  2) Add custom resolution (Width x Height)")
        print("  3) Remove a resolution")
        print("  4) Clear all custom resolutions")
        print("  5) Apply all resolutions now")
        print("  6) Restore Wine to stock backup")
        print("  0) Exit")
        choice = input(f"\n{CYAN}Your choice [0-6]: {RESET}").strip()

        if choice == "1":
            cmd_list()
        elif choice == "2":
            try:
                raw_w = input("Enter width (e.g. 1350): ").strip()
                raw_h = input("Enter height (e.g. 1080): ").strip()
                desc = input("Description/tag (optional): ").strip()
                w, h = int(raw_w), int(raw_h)
                cmd_add(w, h, desc)
            except ValueError:
                print(f"{RED}[ERROR]{RESET} Invalid numbers entered.")
        elif choice == "3":
            try:
                raw_w = input("Enter width to remove: ").strip()
                raw_h = input("Enter height to remove: ").strip()
                w, h = int(raw_w), int(raw_h)
                cmd_remove(w, h)
            except ValueError:
                print(f"{RED}[ERROR]{RESET} Invalid numbers entered.")
        elif choice == "4":
            confirm = input("Clear all custom resolutions? [y/N]: ").strip().lower()
            if confirm in ("y", "yes"):
                cmd_clear()
        elif choice == "5":
            apply_modes(verbose=True)
        elif choice == "6":
            cmd_restore()
        elif choice in ("0", "q", "exit"):
            print(f"\n{GREEN}{BOLD}See you next time!{RESET}\n")
            break
        else:
            print(f"{RED}Invalid option selected.{RESET}")

def main():
    parser = argparse.ArgumentParser(description="osu-res: Custom Resolution Manager for osu! under Wine")
    subparsers = parser.add_subparsers(dest="command")

    # add
    p_add = subparsers.add_parser("add", help="Add custom resolution")
    p_add.add_argument("width", type=int, nargs="?", help="Width in pixels")
    p_add.add_argument("height", type=int, nargs="?", help="Height in pixels")
    p_add.add_argument("-d", "--desc", type=str, help="Description label")

    # remove
    p_rm = subparsers.add_parser("remove", help="Remove custom resolution")
    p_rm.add_argument("width", type=int, help="Width in pixels")
    p_rm.add_argument("height", type=int, help="Height in pixels")

    # clear
    subparsers.add_parser("clear", help="Clear all custom resolutions")

    # list
    subparsers.add_parser("list", help="List custom resolutions and display info")

    # apply
    subparsers.add_parser("apply", help="Apply all configured modes to Wine and XRandR")

    # restore
    subparsers.add_parser("restore", help="Restore original unmodified win32u.so from backup")

    args = parser.parse_args()

    if args.command == "add":
        if args.width and args.height:
            cmd_add(args.width, args.height, args.desc)
        else:
            try:
                w = int(input("Enter width: ").strip())
                h = int(input("Enter height: ").strip())
                desc = input("Description: ").strip()
                cmd_add(w, h, desc)
            except ValueError:
                print(f"{RED}[ERROR]{RESET} Invalid numbers entered.")
    elif args.command == "remove":
        cmd_remove(args.width, args.height)
    elif args.command == "clear":
        cmd_clear()
    elif args.command == "list":
        cmd_list()
    elif args.command == "apply":
        apply_modes(verbose=False)
    elif args.command == "restore":
        cmd_restore()
    else:
        interactive_menu()

if __name__ == "__main__":
    main()
